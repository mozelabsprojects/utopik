model Game {
  id               String       @id @default(cuid())
  countryName      String
  turn             Int          @default(1)
  budget           Float        @default(5000)
  military         Float        @default(50)
  happiness        Float        @default(50)
  health           Float        @default(50)
  environment      Float        @default(50)
  education        Float        @default(50)
  stability        Float        @default(50)
  foreignRelations Float        @default(50)
  
  // Yeni Kaynaklar
  energy           Float        @default(100)
  food             Float        @default(100)
  materials        Float        @default(100)
  
  // Siyasi ve Yeni Statler
  population       Float        @default(10.0) // Milyon cinsinden nüfus
  popularity       Float        @default(50) // Başkanlık desteği
  politicalCapital Float        @default(100) // Siyasi sermaye
  activeQuests     String       @default("[]") // JSON formatında (Side quests)
  nextElectionTurn Int          @default(10) // 10 turda bir seçim

  // V4 Yeni Sistemler
  turnReports      String       @default("[]") // JSON (Tur Raporları)
  activeCrises     String       @default("[]") // JSON (Devam Eden Krizler)
  factions         String       @default("{}") // JSON (Fraksiyon değerleri)
  activeLaws       String       @default("[]") // JSON (Yürürlükteki Kanunlar)
  historicalData   String       @default("[]") // JSON (Tur bazlı istatistik geçmişi)

  // V5 Ütopya Çağı Sistemleri
  megaProjects     String       @default("[]") // JSON (Başlanan/Biten Mega Projeler)
  ministers        String       @default("{}") // JSON (Atanan Bakanlar)
  activePetitions  String       @default("[]") // JSON (Bekleyen Vatandaş Dilekçeleri)
  diplomacyState   String       @default("{}") // JSON (Savaş ve İttifaklar)
  marketState      String       @default("{}") // JSON (Borsa ve Envanter)
  
  // V6 Özellikleri
  researchPoints   Float        @default(0)    // Ar-Ge Puanı
  unlockedTechs    String       @default("[]") // JSON (Açılan Teknolojiler)

  // V7 Merkez Bankası ve Ekonomi
  inflation        Float        @default(5.0)  // Yıllık/Turluk Enflasyon Oranı (%)
  activeBonds      String       @default("[]") // JSON (İhraç Edilen Tahviller / Borçlar)
  achievements     String       @default("[]") // JSON (Kazanılan Başarımlar)

  isGameOver       Boolean      @default(false)
  gameOverReason   String?
  isBankrupt       Boolean      @default(false)
  bankruptTurns    Int          @default(0)
  currentEventId   String?
  usedEventIds     String       @default("[]")
  eventFlags       String       @default("[]") // Kelebek Etkisi bayrakları (JSON)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  investments      Investment[]
  worldCountries   WorldCountry[]
  tradeAgreements  TradeAgreement[]
}

model Investment {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sector String
  amount Float
  turn   Int
}

model WorldCountry {
  id               String @id @default(cuid())
  gameId           String
  game             Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name             String
  budget           Float
  military         Float
  happiness        Float
  health           Float
  environment      Float
  education        Float
  stability        Float
  foreignRelations Float
  isPlayer         Boolean @default(false)
}

model TradeAgreement {
  id             String @id @default(cuid())
  gameId         String
  game           Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  partnerName    String
  incomePerTurn  Float
  turnsRemaining Int
}
